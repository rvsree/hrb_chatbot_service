## ---------------------------------------------------------------------------
## App Settings  — read by app_settings.py
## ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:8091
APP_APP_NAME=Agentic Workflow Chatbot
APP_ENVIRONMENT=local
APP_DEBUG=false

## ---------------------------------------------------------------------------
## App Gateway  — read by app_gateway.py
## ---------------------------------------------------------------------------
APP_CSRF_PROTECTION=true
APP_RATE_LIMITING=true
APP_RATE_LIMIT_REQUESTS=100
APP_RATE_LIMIT_DURATION=30

## ---------------------------------------------------------------------------
## OpenAI  — read by openai_client.py
## Required - the app runs fully on OpenAI alone; every other LLM provider
## below is optional.
## ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small           #(1536 dimensional embedding)
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_PLANNER_MODEL=gpt-4.1-mini                     #(Phase 65/243 - overrides OPENAI_CHAT_MODEL for the Planner Agent only, request-overridable via classification_options.planner_model) #2026-10-26 HOTFIX: was gpt-4.1-nano, OpenAI shut that model down 2026-10-23 - same root cause as guardrails_input.py's own 2026-10-23 hotfix, applied here too
OPENAI_DECOMPOSE_MODEL=gpt-4.1-mini                   #(Phase 130/243 - overrides OPENAI_CHAT_MODEL for genai-rag's query decomposition only, request-overridable via classification_options.decompose_model) #2026-10-26 HOTFIX: was gpt-4.1-nano, same shutdown as above
GUARDRAILS_SUPPORTED_MODELS=gpt-4.1-mini              #(Phase 244 - allow-list guardrails_model is validated against; request-overridable via guardrails_model, 422 if not listed) #2026-10-26 HOTFIX: dropped dead gpt-4.1-nano from the allow-list
OPENAI_ROUTER_MODEL=gpt-4.1-nano                      #(Phase 240 - overrides OPENAI_CHAT_MODEL for the auto-router's single-vs-multi classification step only)
AUTO_ROUTER_ESCALATION_THRESHOLD=0.5                  #(Phase 240 - internal routing trigger, separate from eval_options.eval_score_threshold; escalates single->multi-agentic-rag below this)
EVAL_GROUNDEDNESS_ENABLED=true                        #(Phase 246 - set false to skip this live judge call on every query with sources, a real cost cut)
EVAL_COMPLETENESS_ENABLED=true                        #(Phase 246 - same as above)
EVAL_RETRIEVAL_RELEVANCE_ENABLED=true                 #(Phase 246 - set false to also skip the expensive wider-pool fetch (up to 20 chunks) this judge call needs - the single biggest real cost lever of these 3)
EVAL_ANSWER_RELEVANCY_ENABLED=false                   #(Phase 250 - brand new metric, defaults OFF not ON - set true to add 1 more live judge call per query with sources)

## ---------------------------------------------------------------------------
## Anthropic — read by anthropic_client.py (optional)
## ---------------------------------------------------------------------------
ANTHROPIC_LLM_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
ANTHROPIC_WORKSPACE_ID=
# ask()/ask_with_tools() fallback when the caller doesn't pass max_tokens -
# Anthropic's API requires max_tokens, unlike OpenAI/Bedrock.
ANTHROPIC_DEFAULT_MAX_TOKENS=1024

## ---------------------------------------------------------------------------
## OpenRouter — read by open_router_client.py (optional)
## ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
OPENROUTER_HEALTH_CHECK_TIMEOUT_SECONDS=10

## ---------------------------------------------------------------------------
## Bedrock — read by bedrock_client.py
## No credentials configured yet - leave AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
## blank to use boto3's own default credential chain (profile, IAM role) instead
## of putting them here. AWS_REGION and BEDROCK_MODEL_ID have working defaults
## (us-east-1 / amazon.nova-pro-v1:0) if left blank.
## ---------------------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=

## ---------------------------------------------------------------------------
## AWS SES — read by ses_client.py (Phase 136, optional - only needed for
## the GenAI Chat Workflow's email-send feature). Reuses AWS_REGION/
## AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY from the Bedrock block above -
## same AWS account, no separate credentials needed.
## One-time setup this .env can't do by itself: a new AWS account's SES
## starts in sandbox mode (can only send to pre-verified addresses), and
## SES_SENDER_EMAIL itself must be verified in the SES console before any
## send succeeds, sandbox or not.
## ---------------------------------------------------------------------------
SES_SENDER_EMAIL=

## ---------------------------------------------------------------------------
## Tavily web search — read by tavily_client.py (optional)
## ---------------------------------------------------------------------------
TAVILY_API_KEY=
TAVILY_SEARCH_ENABLED=true
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_ANSWER=false
TAVILY_TIMEOUT=30
TAVILY_HEALTH_CHECK_TIMEOUT_SECONDS=10
TAVILY_MAX_RETRY_BACKOFF_SECONDS=10

## ---------------------------------------------------------------------------
## GitHub Actions status — read by github_actions_client.py (Phase 183,
## Deployment Dashboard's CI/Build Status tab, optional). GITHUB_TOKEN needs
## only read-only actions:read scope - this client never triggers/cancels a
## run. A personal access token (classic or fine-grained) works; repo-scoped
## is enough, no org-wide access needed.
## ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=rvsree/hrb_chatbot_service

## ---------------------------------------------------------------------------
## Serp API web search (optional)
## ---------------------------------------------------------------------------
SERP_API_KEY=
SERP_SEARCH_ENABLED=true

## ---------------------------------------------------------------------------
## LangSmith — read by common/observability/langsmith_tracing.py
## Off by default to stay inside the 5,000-trace/month free tier. Turn on
## only while testing a specific milestone, then back off.
## ---------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_ENABLED=false
LANGSMITH_PROJECT=hrb_chatbot_service
# Keeps local-dev and production traces in separate LangSmith projects
# (hrb_chatbot_service_local vs hrb_chatbot_service_prod) so they never mix under
# the same LANGSMITH_PROJECT name. Production's own App Runner config
# sets the opposite values (LOCAL=false, PROD=true).
HRB_CHATBOT_LOCAL=true
HRB_CHATBOT_PROD=false
# LANGSMITH_ENDPOINT=                                 #(not yet wired into langsmith_tracing.py - only needed for the EU region or a self-hosted LangSmith; default US endpoint is used otherwise)
# LANGSMITH_TRACING_SAMPLE_RATE=                       #(not yet wired - 0.0-1.0, traces a random fraction of calls instead of all-or-nothing, cheaper way to stay under the free-tier quota than manually toggling LANGSMITH_ENABLED)

## ---------------------------------------------------------------------------
## DeepEval — read by nemoguardrails-independent deepeval library itself
## (not by our own code) - opts out of DeepEval's own anonymous telemetry.
## ---------------------------------------------------------------------------
DEEPEVAL_TELEMETRY_OPT_OUT=YES

## ---------------------------------------------------------------------------
## hrb_lms_mcp (Phase 49) — sibling project's MCP server, local dev only.
## Phase 53: real OAuth2 client-credentials, not the dead X-API-Key header
## (found this session to be configured but never actually enforced).
## client_secret is handed over once at provisioning time by hrb_lms_mcp -
## only ever lives in your own gitignored .env, never here.
## ---------------------------------------------------------------------------
HRB_LMS_MCP_URL=http://127.0.0.1:8190/mcp
HRB_LMS_MCP_OAUTH_TOKEN_URL=http://127.0.0.1:8190/oauth/token
HRB_LMS_MCP_OAUTH_CLIENT_ID=hrb-chatbot-v2
HRB_LMS_MCP_OAUTH_CLIENT_SECRET=
# Phase 185 - the MCP circuit breaker's cooldown: once 2+ consecutive real
# failures are recorded, skip a real call for this many seconds and fail
# fast instead (mcp_tools/__init__.py's _check_circuit_breaker()).
MCP_CIRCUIT_BREAKER_COOLDOWN_SECONDS=10

## ---------------------------------------------------------------------------
## Shared hr_chatbot database (Phase 50) — same Postgres server as
## POSTGRES_DB_* above, different database. Holds the app_tracking MCP
## registry tables and hrb_chatbot_service_core (Phase 50's OAuth2 schema),
## shared with hrb_lms_mcp/hrb_emp_assist. Reuses POSTGRES_DB_HOST/PORT/
## USER/PASSWORD above - same server, just a different db_name.
## ---------------------------------------------------------------------------
HR_CHATBOT_SHARED_DB_NAME=hr_chatbot

## ---------------------------------------------------------------------------
## RAG pipeline — read by common/clients/db_client/db_gateway.py
## ---------------------------------------------------------------------------
ACTIVE_VECTOR_DB=chromadb
ACTIVE_LLM_PROVIDER=openai

RAG_METADATA_STORE=sqlite
RAG_MAX_CHROMA_DISTANCE=1.1
RAG_MIN_PINECONE_SCORE=0.45
RAG_DEFAULT_TOP_K=5
RAG_DEFAULT_TEMPERATURE=0.0
RAG_DEFAULT_SEARCH_STRATEGY=similarity

CHUNK_DEFAULT_SIZE=1000
CHUNK_DEFAULT_OVERLAP=150
CHUNK_LARGE_DOCUMENT_MIN_LENGTH=10000
CHUNK_LARGE_DOCUMENT_CHUNK_SIZE=1500
METADATA_EXTRACTION_MAX_CHARACTERS=3000

## ---------------------------------------------------------------------------
## Document uploads — read by models/documents.py
## ---------------------------------------------------------------------------
# Server-side policy, not a per-request override - a caller raising its own
# upload limit would be a security issue, not a feature.
MAX_UPLOAD_FILE_SIZE_BYTES=20971520
# Phase 46: below this, DELETE .../documents/cleanup treats a document as
# test noise, not real content - every test-generated file across this
# project's suite is a short fake string, far under this.
TEST_NOISE_MAX_FILE_SIZE_BYTES=1024

## ---------------------------------------------------------------------------
## ChromaDB — read by chroma_db_client.py
## ---------------------------------------------------------------------------
CHROMA_DB_MODE=persistent
CHROMA_DB_HOST=localhost
CHROMA_DB_PORT=8000
CHROMA_DB_PERSIST_DIR=data/chroma_db
CHROMA_DB_ALLOW_RESET=false

## ---------------------------------------------------------------------------
## Pinecone — read by pinecone_client.py (optional - only needed if
## ACTIVE_VECTOR_DB=pinecone)
## ---------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hrb-chatbot-kb
PINECONE_CLOUD=aws
PINECONE_ENVIRONMENT=us-east-1
PINECONE_METRIC=cosine
PINECONE_DIMENSION=1536
#PINECONE_INDEX_HOST=
# How long/how often to poll a newly-created index before giving up on it
# being ready (pinecone_client.py's _wait_until_ready()).
PINECONE_INDEX_READY_TIMEOUT_SECONDS=60
PINECONE_INDEX_READY_POLL_SECONDS=2

## ---------------------------------------------------------------------------
## SQLite Db — read by sqlite_db_client.py
## ---------------------------------------------------------------------------
SQLITE_DB_PATH=data/sqlite_db.sqlite3

## ---------------------------------------------------------------------------
## Postgres Db — read by postgres_client.py (optional - only needed if
## RAG_METADATA_STORE=postgres)
## ---------------------------------------------------------------------------
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=hrb_chatbot_v2
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=

## ---------------------------------------------------------------------------
## Admin login seed — read by api/auth/login.py. One-time seed code for the
## admin role's very first login (forces a reset immediately after) - pick
## your own value here, never reuse a value that's ever been committed.
## ---------------------------------------------------------------------------
ADMIN_SEED_SECRET_CODE=
# Milestone 3 - recovery code that clears a secret-code lockout immediately.
# Leave unset to disable the recovery path entirely (lockout then only
# clears itself after 15 minutes).
ADMIN_UNLOCK_CODE=

## ---------------------------------------------------------------------------
## Redis (Phase 84) — answer cache, embedding cache, rate limiter.
## Upstash-hosted (not AWS ElastiCache - VPC-only, no public endpoint).
## Sign up at upstash.com, create a Redis database, paste its connection
## string below (format: rediss://default:<password>@<host>:<port>).
## ---------------------------------------------------------------------------
REDIS_URL=
#REDIS_ANSWER_CACHE_TTL_SECONDS=21600          #(6 hours - default if unset)
#REDIS_EMBEDDING_CACHE_TTL_SECONDS=2592000     #(30 days - default if unset)
#REDIS_STM_TTL_SECONDS=7200                    #(2 hours - default if unset)

## ---------------------------------------------------------------------------
## Neon Postgres — read by postgresql_client.py (optional - the AWS/
## production metadata store; local dev normally uses SQLite above instead)
## ---------------------------------------------------------------------------
NEON_POSTGRES_DB_HOST=
NEON_POSTGRES_DB_PORT=
NEON_POSTGRES_DB_NAME=HR_Benefits
NEON_POSTGRES_DB_USER=
NEON_POSTGRES_DB_PASSWORD=
NEON_POSTGRES_HRB_CHATBOT=

## ---------------------------------------------------------------------------
## S3 async ingestion (Phase 88-90) — presigned uploads, read by s3_upload_client.py.
## Points at the DEV bucket/queue (hrb-chatbot-kb-uploads-dev / ingest-queue-dev,
## -dev suffix on both) - a completely separate bucket/queue from the real
## production ones App Runner/the real Lambda use, so local testing can never
## race or collide with production again (Phase 90 found this the hard way -
## see RAG-ROADMAP.md). Objects in the dev bucket auto-expire after 7 days.
## ---------------------------------------------------------------------------
S3_UPLOAD_BUCKET=hrb-chatbot-kb-uploads-dev
S3_PRESIGNED_URL_EXPIRY_SECONDS=300

## ---------------------------------------------------------------------------
## Leave documents + admin docs viewer (Phase 162/170) — read by
## s3_upload_client.py. Deliberately a SEPARATE bucket from S3_UPLOAD_BUCKET
## above: that bucket has a whole-bucket S3 event notification that triggers
## KB ingestion, so a leave document (e.g. a medical certificate) dropped
## there would get silently chunked/embedded into the shared RAG index - a
## real privacy bug, not hypothetical. The admin-docs viewer (Phase 170)
## reuses this same bucket under a separate admin-docs/ prefix, same reason.
## ---------------------------------------------------------------------------
LEAVE_DOCS_S3_BUCKET=

## scripts/run_local_lambda_worker.py - polls this REAL (but dev-only) queue
## directly from localhost (no emulation) so the whole S3 -> SQS -> index flow
## can be developed/tested without building/pushing a Docker image each time,
## and without ever touching the production queue/bucket. Replace
## <aws_account_id> with your own account id.
SQS_INGEST_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<aws_account_id>/hrb-chatbot-ingest-queue-dev
