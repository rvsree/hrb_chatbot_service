        </mxCell>
        <mxCell id="n_read_replica" value="Postgres read replica&#10;admin/eval-dashboard reads never compete with live conversation reads" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9.5;align=center;dashed=1;" vertex="1" parent="1">
