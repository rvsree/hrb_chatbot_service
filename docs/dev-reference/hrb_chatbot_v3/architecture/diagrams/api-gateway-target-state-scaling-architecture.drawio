        <mxCell id="n_clients" value="Employees &#183; HR Admins&#10;up to 5,000, bursty, enrollment-season spikes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#262B36;fontSize=10.5;align=center;" vertex="1" parent="1">
