<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="API Gateway - Target State (Scaling)" id="api-gateway-target">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760" math="0" shadow="0">
