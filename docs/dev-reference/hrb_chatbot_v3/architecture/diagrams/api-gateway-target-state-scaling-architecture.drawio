        </mxCell>
        <mxCell id="n_cb" value="Circuit breaker on forward_request()&#10;extend the MCP circuit-breaker pattern already used elsewhere &#8212; not invented new" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9.5;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- Backend, split -->
        <mxCell id="z_backend" value="Downstream, finally split" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C9792E;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontColor=#7F3300;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="190" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n_retrieval_cutover" value="rag_retrieval_service&#10;cutover finally flipped &#8212; the split exists today, standalone; this is the decision, not new code" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9.5;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="230" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_provider_spread" value="LLM calls spread across providers&#10;use the existing LlmProvider gateway (OpenAI/Anthropic/Bedrock/OpenRouter) instead of one provider absorbing all load" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="300" width="300" height="70" as="geometry" />
