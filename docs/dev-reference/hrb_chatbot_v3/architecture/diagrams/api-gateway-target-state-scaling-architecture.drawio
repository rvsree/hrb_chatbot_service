        <mxCell id="z_edge" value="Edge (new)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C9792E;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontColor=#7F3300;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="190" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n_waf" value="WAF&#10;covers this gateway too &#8212; today only the UI's own CloudFront has one" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=10;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="230" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_tuned_scaling" value="App Runner autoscaling, tuned&#10;per-service, not shared DEFAULT (min raised above 1 &#8212; avoids cold-start latency spikes)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9.5;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="300" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Gateway logic, mostly unchanged -->
        <mxCell id="z_logic" value="Gateway logic &#8212; mostly unchanged, already scale-ready" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#548235;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontColor=#375623;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="190" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n_ratelimit_keep" value="Rate limit: unchanged&#10;already Redis-backed (not in-process) &#8212; this already scales horizontally today" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#262B36;fontSize=10;align=center;" vertex="1" parent="1">
