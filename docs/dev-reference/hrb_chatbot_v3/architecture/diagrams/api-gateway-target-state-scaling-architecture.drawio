          <mxGeometry x="1340" y="32" width="220" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n_warning" value="Target design, NOT built. Every orange-dashed box below is a proposed change grounded in a real, already-identified bottleneck &#8212; not a generic AWS checklist." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;dashed=1;fontColor=#262B36;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1540" height="40" as="geometry" />
