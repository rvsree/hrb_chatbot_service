        </mxCell>
        <mxCell id="n_pinecone_only" value="Pinecone only, production&#10;ChromaDB fallback fully retired &#8212; it can't scale across App Runner instances" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9.5;align=center;dashed=1;" vertex="1" parent="1">
