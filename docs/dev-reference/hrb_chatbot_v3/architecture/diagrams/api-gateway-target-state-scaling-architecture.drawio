        </mxCell>
        <mxCell id="hdr_title" value="hrb_api_gateway_service &#8212; Target State for 2,000&#8211;5,000 Users (NOT built)" style="text;html=1;fontColor=#FFFFFF;fontSize=26;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" value="Nothing in the orange-bordered boxes below exists today. Grounded in the 2026-10-24 scaling-tier discussion, not invented fresh here." style="text;html=1;fontColor=#AFC6F0;fontSize=13;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="1300" height="24" as="geometry" />
