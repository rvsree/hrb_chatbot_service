          <mxGeometry x="640" y="290" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_c4" value="hrb_platform_components" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#262B36;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="930" y="290" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_not1" value="hrb_chatbot_service (pre-split monolith) and hrb_chatbot_ui (different language) do NOT depend on this library" style="text;html=1;fontColor=#595959;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="1140" height="20" as="geometry" />
        </mxCell>

        <mxCell id="n_footer" value="Why a git-tag pin, not a floating branch or 10 separate PyPI packages: a new commit to main would silently change what every consumer builds next; separate packages mean 10 version numbers to keep compatible. One tag = reproducible, explicit, one source of truth." style="text;html=1;fontColor=#595959;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1220" height="40" as="geometry" />
        </mxCell>

