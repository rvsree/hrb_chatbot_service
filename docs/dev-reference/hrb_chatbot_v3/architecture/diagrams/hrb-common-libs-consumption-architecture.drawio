        <mxCell id="hdr_title" value="hrb-common-libs &#8212; Consumption Architecture (not a deployed service)" style="text;html=1;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" value="Shared connectors + observability, pip-installed via a git-tag pin &#8212; no deployment or scaling diagram applies; there's no running instance of this repo." style="text;html=1;fontColor=#AFC6F0;fontSize=13;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="1100" height="24" as="geometry" />
