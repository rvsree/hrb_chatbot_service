          <mxGeometry x="1050" y="32" width="220" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n_lib" value="hrb-common-libs @ a pinned git tag&#10;pip extras: [llm] [vectordb] [metadata] [cache] [observability]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B2D8E;fontColor=#262B36;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="z_consumers" value="Consumers &#8212; 4 of 6 real deployables, each builder stage re-clones the pinned tag" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#1F3864;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontColor=#1F3864;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_c1" value="hrb_api_gateway_service" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#262B36;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_c2" value="rag_ingestion_service" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#262B36;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="290" width="270" height="50" as="geometry" />
