          <mxGeometry x="40" y="190" width="420" height="220" as="geometry" />
        </mxCell>
        <mxCell id="n_ci" value="Fix deploy-lambda.yml's placeholder ECR_REPOSITORY&#10;today the real Lambda is shipped by hand &#8212; same bug class hrb_chatbot_service already got bitten by once" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9.5;align=center;dashed=1;" vertex="1" parent="1">
