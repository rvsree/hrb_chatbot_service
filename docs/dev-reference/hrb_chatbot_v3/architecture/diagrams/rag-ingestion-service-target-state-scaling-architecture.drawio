        </mxCell>
        <mxCell id="n_concurrency" value="Reserved concurrency on the Lambda&#10;today: none set &#8212; a large bulk upload could starve the account's shared concurrent-execution pool" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9.5;align=center;dashed=1;" vertex="1" parent="1">
