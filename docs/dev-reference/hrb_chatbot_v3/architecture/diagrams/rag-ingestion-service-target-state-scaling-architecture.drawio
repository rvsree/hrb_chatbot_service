        <mxCell id="n_dedup_keep" value="Content-hash dedup + supersede&#10;already idempotent, already handles re-uploads correctly" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#262B36;fontSize=9.5;align=center;" vertex="1" parent="1">
