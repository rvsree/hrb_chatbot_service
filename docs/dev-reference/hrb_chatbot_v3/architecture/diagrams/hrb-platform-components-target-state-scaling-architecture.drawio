<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="hrb_platform_components - Target State" id="hpc-target">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="hdr_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A2744;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1260" height="92" as="geometry" />
        </mxCell>
        <mxCell id="hdr_title" value="hrb_platform_components &#8212; Target State: Honestly, Mostly Unchanged" style="text;html=1;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="hdr_sub" value="Not every service has a growth story. This one's traffic scales with admin headcount, not employee headcount &#8212; and admin headcount doesn't grow with the other 3 tiers." style="text;html=1;fontColor=#AFC6F0;fontSize=13;fontStyle=2;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="1150" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hdr_view_tag" value="VIEW &#183; target state, minimal" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#F4B942;strokeColor=none;fontColor=#1A2744;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1050" y="32" width="220" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n_honest" value="Honest assessment: at 100, 1,000, 2,000, or 5,000 employees, this component's real load is unchanged &#8212; a handful of admins, not the employee base, drive its traffic. No autoscaling tuning, no read replica, no provider spread apply here the way they do for the chat-facing services." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#262B36;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="z_real" value="The one real risk, not user-growth-related" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C9792E;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontColor=#7F3300;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="1220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_ghrate" value="GitHub API rate limits&#10;if more repos/workflows get added (already grew from 4 to 8 deployables, Phase 233 &#8594; 255), polling frequency could matter &#8212; not employee count, repo count" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9.5;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_cache" value="Cache GitHub Actions API responses&#10;short TTL, avoids hitting rate limits as more repos get added to the dashboard" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontStyle=1;fontSize=9.5;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="250" width="580" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n_footer" value="This is the honest counter-example in the set: not every service needs a scaling narrative, and inventing one here would be padding, not analysis." style="text;html=1;fontColor=#595959;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="1220" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#C9792E;" edge="1" parent="1" source="n_ghrate" target="n_cache"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
