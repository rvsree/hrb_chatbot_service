        <mxCell id="n_ping" value="GET /ping&#10;process-is-up only" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#262B36;fontSize=10.5;align=center;" vertex="1" parent="1">
