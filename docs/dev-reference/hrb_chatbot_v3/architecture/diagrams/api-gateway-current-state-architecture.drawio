        <mxCell id="z_logic" value="Gateway logic, applied to the catch-all route only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#548235;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontColor=#375623;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="140" width="420" height="280" as="geometry" />
        </mxCell>
        <mxCell id="n_cors" value="CORS&#10;configure_cors() &#8212; applies to every route, including /ping and /health" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#262B36;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="175" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_ratelimit" value="Rate limit (dependency)&#10;60 req/min per employee_id (IP fallback)&#10;Redis INCR+EXPIRE, fails OPEN if Redis down" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#262B36;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="880" y="175" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_contract" value="Contract validation&#10;validate_contract() &#8212; real check for 3 named endpoints only, no-op elsewhere" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#262B36;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="250" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n_rbac_gap" value="RBAC / role check: NOT ENFORCED HERE&#10;rbac.py exists in this repo but is never wired into main.py&#10;&#8220;a generic catch-all proxy has no per-path role mapping to enforce yet&#8221; &#8212; real quote from the code's own comment" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B23A2F;fontColor=#262B36;fontStyle=2;fontSize=9.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="880" y="250" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_forward" value="forward_request()&#10;httpx.AsyncClient, timeout 90s&#10;BACKEND_SERVICE_URL (Secrets Manager)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#262B36;fontStyle=1;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="345" width="380" height="60" as="geometry" />
        </mxCell>

        <!-- Backend + infra -->
        <mxCell id="z_backend" value="Downstream" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontColor=#595959;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="140" width="420" height="280" as="geometry" />
        </mxCell>
        <mxCell id="n_backend" value="hrb_chatbot_service (today)&#10;the real role check happens here, per-request, downstream &#8212; not at the gateway" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;fontColor=#262B36;fontStyle=1;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="1160" y="180" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_redis_dep" value="Redis&#10;rate-limit counters only &#8212; this service holds no other state" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#548235;fontColor=#262B36;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="1160" y="270" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_secrets_dep" value="Secrets Manager&#10;BACKEND_SERVICE_URL, REDIS_URL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9792E;fontColor=#262B36;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="1160" y="350" width="380" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n_note" value="Stateless on purpose: every task can serve any request, since the only shared state (rate-limit counters) lives in Redis, not in-process. This is what makes horizontal autoscaling safe without any session affinity." style="text;html=1;fontColor=#595959;fontSize=10.5;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1500" height="36" as="geometry" />
        </mxCell>

        <mxCell id="n_footer" value="Verified directly against real source (main.py, rate_limit.py, rbac.py), 2026-10-24 &#8212; not assumed from earlier docs. Correction: this diagram's own earlier draft (platform-overview.html) described this service as doing &#8220;RBAC, CORS, rate-limit&#8221; &#8212; the RBAC part was wrong; flagged here, not yet fixed in that file." style="text;html=1;fontColor=#B23A2F;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1500" height="40" as="geometry" />
